# ── Dependencies ────────────────────────────────────────────────
node_modules/

# ── Build artifacts we do NOT track ─────────────────────────────
# The unminified debug build is regenerated on demand; don't commit it.
index_readable.html
*.tmp

# Test bundles, regenerated by `npm test` (see test/build-bundle.mjs)
test/.build/
test/.tmp/

# IMPORTANT: index.html is a build product, but GitHub Pages serves the
# committed copy — so it MUST stay tracked. Do not add it here.

# ── OS / editor cruft ───────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
.vscode/
.idea/

# ── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
